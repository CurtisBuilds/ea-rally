# Supabase — get from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma — get from Project Settings > Database
DATABASE_URL=postgresql://postgres.your-ref:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.your-ref:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# App
NEXT_PUBLIC_APP_URL=https://rally.elevationathletics.ca
